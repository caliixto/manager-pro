const mongoose = require("mongoose");
const Schema = mongoose.Schema;

const grupoSchema = new Schema({
  equipo: { type: Schema.Types.ObjectId, ref: 'Users', required: true },
  temporada: { type: String, required: true },
  grupo: { type: String, enum: ['A','B','C','D','E','F','G','H'], required: true },
  rivalesGrupo: [{ nombre: String, escudo: String, nivel: Number }]
});

module.exports = mongoose.model('grupos', grupoSchema);